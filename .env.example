# Local:
# NEXT_PUBLIC_API_URL=/api
# BACKEND_API_URL=http://localhost:4000/api
# NEXT_PUBLIC_ENV=development

# Test server (172.16.104.40)
# test3.trustbank.uz → :3000 (landing)
# API on test1.trustbank.uz

PORT=3000
NODE_ENV=production
TZ=Asia/Tashkent
NEXT_TELEMETRY_DISABLED=1

# Browser → public API domain
NEXT_PUBLIC_API_URL=https://test1.trustbank.uz/api

# Server-side (SSR) → dashboard-api on same host / docker network
BACKEND_API_URL=http://127.0.0.1:4000/api
# If containers share a docker network by service name:
# BACKEND_API_URL=http://dashboard-api:4000/api

NEXT_PUBLIC_ENV=production
