{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SF Pro Display|Inter))/i]",
        "message": "Font not provided by the design system. Available: SF Pro Display, Inter."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent-blue-link",
      "--accent-brown",
      "--accent-danger",
      "--accent-deep-red",
      "--accent-green-text",
      "--accent-light-blue",
      "--accent-light-green",
      "--accent-pink",
      "--accent-teal",
      "--accent-warning",
      "--accent-yellow",
      "--ash",
      "--body",
      "--canvas-dark",
      "--canvas-light",
      "--charcoal",
      "--container-max",
      "--divider-soft",
      "--faint",
      "--font-body",
      "--font-display",
      "--hairline-dark",
      "--hairline-light",
      "--hairline-strong",
      "--ink",
      "--link",
      "--mute",
      "--on-dark",
      "--on-dark-mute",
      "--on-primary",
      "--primary",
      "--primary-bright",
      "--primary-deep",
      "--radius-button",
      "--radius-full",
      "--radius-lg",
      "--radius-md",
      "--radius-none",
      "--radius-sm",
      "--radius-xl",
      "--space-band",
      "--space-block",
      "--space-lg",
      "--space-md",
      "--space-section",
      "--space-sm",
      "--space-xl",
      "--space-xs",
      "--space-xxl",
      "--space-xxs",
      "--space-xxxl",
      "--stone",
      "--surface-card",
      "--surface-deep",
      "--surface-elevated",
      "--surface-soft"
    ],
    "tokenKinds": {
